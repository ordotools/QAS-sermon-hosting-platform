# Required
SECRET_KEY=change-me-to-a-long-random-string

# Database (SQLite dev default; PostgreSQL for Docker/prod)
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# DATABASE_URL=postgresql+asyncpg://qas:qas@db:5432/qas

# Storage: local (dev) or b2 (prod)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/media

# Backblaze B2 (STORAGE_BACKEND=b2)
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com

# Bootstrap superuser on first startup
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=change-me

# Limits
MAX_UPLOAD_SIZE_MB=500
SESSION_MAX_AGE=604800

# App
DEBUG=true
